# Database administrator role (admin), separate from PostgreSQL bootstrap
# and the application administrator. Set a private value before first start.
ADMIN_PASSWORD=
# Password of the clinlims database user the application connects with.
OE_DB_PASSWORD=

# Set store passwords before the first start and retain them with the backup.
# An incorrect existing password stops initialization; stores are never reset
# just because a password changed.
SSL_TRUSTSTORE_PATH=/etc/openelis-global/truststore
SSL_TRUSTSTORE_PASSWORD=tspass
SSL_KEYSTORE_PATH=/etc/openelis-global/keystore
SSL_KEYSTORE_PASSWORD=kspass

# Leave empty for a fresh installation: the certs service generates an independent
# key in install/encryption.key and the webapp entrypoint loads it. Back up that
# file with the database. Existing sites must retain their effective old key;
# see the explicit adoption procedure in README.md before upgrading.
OE_ENCRYPTION_PASSWORD=

# Source for the proxy's nginx certs/keys mounts.
# Default = the named volumes (filled by the certs service).
# In deployment, set these to a host directory holding the real certificate
# and key as regular files. Do not point them at /etc/letsencrypt/live/<domain>:
# its files are symlinks into ../../archive/<domain>, which does not exist
# inside the container, and the proxy fails with "cannot load certificate".
# Either copy the files out, for example from a certbot deploy hook:
#   cp -L /etc/letsencrypt/live/example.org/fullchain.pem /etc/openelis-certs/
#   cp -L /etc/letsencrypt/live/example.org/privkey.pem /etc/openelis-certs/
#   OE_CERTS_PATH=/etc/openelis-certs
#   OE_KEYS_PATH=/etc/openelis-certs
# or mount the whole Let's Encrypt tree and name the files by their path in it:
#   OE_CERTS_PATH=/etc/letsencrypt
#   OE_KEYS_PATH=/etc/letsencrypt
#   OE_NGINX_CERT=live/example.org/fullchain.pem
#   OE_NGINX_KEY=live/example.org/privkey.pem
OE_CERTS_PATH=certs-vol
OE_KEYS_PATH=keys-vol

# Cert/key file names the nginx proxy looks for inside the mounts above; a
# relative path inside them also works (second example above).
# Default = the self-signed files produced by the certs service.
# In deployment, set these to your real cert file names, e.g.
#   OE_NGINX_CERT=fullchain.pem
#   OE_NGINX_KEY=privkey.pem
OE_NGINX_CERT=apache-selfsigned.crt
OE_NGINX_KEY=apache-selfsigned.key

# Host ports. OpenELIS is served by the proxy on OE_HTTP_PORT (redirects to
# HTTPS) and OE_HTTPS_PORT. The webapp and the FHIR server are also published
# directly on the other four. To serve OpenELIS on 8080/8443, move the
# webapp's own ports first, for example:
#   OE_HTTP_PORT=8080
#   OE_HTTPS_PORT=8443
#   OE_WEBAPP_HTTP_PORT=18080
#   OE_WEBAPP_HTTPS_PORT=18443
OE_HTTP_PORT=80
OE_HTTPS_PORT=443
OE_WEBAPP_HTTP_PORT=8080
OE_WEBAPP_HTTPS_PORT=8443
OE_FHIR_HTTP_PORT=8081
OE_FHIR_HTTPS_PORT=8444

# Code OpenELIS uses to pair with the analyser Bridge when it starts. Leave it
# empty: run.sh and upgrade.sh generate one per installation. To pair again
# later, use Pair again on the Analysers page with this code.
ANALYZER_BRIDGE_PAIRING_CODE=

# Light stack: no FHIR server, no analyser Bridge. Remove the # to run OpenELIS
# without them (lab workflows only, no exchange with other systems).
#COMPOSE_FILE=docker-compose.yml:docker-compose.light.yml
# Required PostgreSQL bootstrap password and initial application password file.
POSTGRES_PASSWORD=
OE_INITIAL_ADMIN_PASSWORD_FILE=./secrets/initial-admin-password
